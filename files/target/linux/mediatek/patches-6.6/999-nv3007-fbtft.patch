diff --git a/drivers/staging/fbtft/fb_nv3007.c b/drivers/staging/fbtft/fb_nv3007.c
new file mode 100644
--- /dev/null
+++ b/drivers/staging/fbtft/fb_nv3007.c
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * fbtft driver for the NewVision NV3007 142x428 SPI TFT panel
+ * (used on EdgePi E87N / Hiveton MT7987 routers)
+ *
+ * Compatible: "newvisionu,nv3007"
+ *
+ * This file is a register-level reconstruction of the OEM driver that is
+ * built into the vendor kernel (fw50x/official_kernel_img.bin).  Every
+ * register write, delay and window offset below was extracted from the
+ * disassembly of the OEM fb_nv3007 driver:
+ *
+ *   init_display  @ 0xffffffc0806f8858   (84 x write_reg + 3 x mdelay)
+ *   set_addr_win  @ 0xffffffc0806f84b8   (per-rotation +12/+14 offsets)
+ *   set_var       @ 0xffffffc0806f8594   (MADCTL 0x36 per rotation)
+ *   set_gamma     @ 0xffffffc0806f8660   (0xFF=0xA5, 0x60+0x10*i+j, 0xFF=0)
+ *   fbtft_display @ 0xffffffc080db5460   (428x142, bpp16, gamma 2x15)
+ *
+ * Do not "improve" these values: this is a vendor-specific NV3007 variant
+ * and register values from other NV3007 panels (TJ-Lab / ESPHome) do not
+ * work on this hardware.
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include "fbtft.h"
+
+#define DRVNAME "fb_nv3007"
+
+/*
+ * OEM gamma string: two identical curves of 15 values (regs 0x60..0x6E and
+ * 0x70..0x7E), copied verbatim from the vendor kernel .rodata at 0xbe43f8.
+ */
+#define NV3007_GAMMA_DEFAULT \
+	"00 02 04 07 05 02 21 23 3A 08 13 13 29 31 0f\n" \
+	"00 02 04 07 05 02 21 23 3A 08 13 13 29 31 0f"
+
+static int init_display(struct fbtft_par *par)
+{
+	par->fbtftops.reset(par);
+	write_reg(par, 0x11);	/* sleep out */
+	mdelay(5);
+	write_reg(par, 0x28);	/* display off */
+
+	/* ---- vendor configuration, 0xFF=0xA5 window ---- */
+	write_reg(par, 0xFF, 0xA5);	/* enter vendor command set */
+	write_reg(par, 0x9A, 0x08);
+	write_reg(par, 0x9B, 0x08);
+	write_reg(par, 0x9C, 0xB0);
+	write_reg(par, 0x9D, 0x17);
+	write_reg(par, 0x9E, 0xC2);
+	write_reg(par, 0x8F, 0x22, 0x04);
+	write_reg(par, 0x84, 0x90);
+	write_reg(par, 0x83, 0x7B);
+	write_reg(par, 0x85, 0x4F);
+	write_reg(par, 0x50, 0x00);
+	write_reg(par, 0x52, 0xD6);
+	write_reg(par, 0x53, 0x04);
+	write_reg(par, 0x54, 0x04);
+	write_reg(par, 0x55, 0x1B);
+	write_reg(par, 0x56, 0x1B);
+	write_reg(par, 0xA0, 0x2A, 0x24, 0x00);
+	write_reg(par, 0xA1, 0x84);
+	write_reg(par, 0xA2, 0x85);
+	write_reg(par, 0xA8, 0x34);
+	write_reg(par, 0xA9, 0x80);
+	write_reg(par, 0xAA, 0x73);
+	write_reg(par, 0xAB, 0x03, 0x61);
+	write_reg(par, 0xAC, 0x03, 0x65);
+	write_reg(par, 0xAD, 0x03, 0x60);
+	write_reg(par, 0xAE, 0x03, 0x64);
+	write_reg(par, 0xB9, 0x82);
+	write_reg(par, 0xBA, 0x83);
+	write_reg(par, 0xBB, 0x80);
+	write_reg(par, 0xBC, 0x81);
+	write_reg(par, 0xBD, 0x02);
+	write_reg(par, 0xBE, 0x01);
+	write_reg(par, 0xBF, 0x04);
+	write_reg(par, 0xC0, 0x03);
+	write_reg(par, 0xC4, 0x33);
+	write_reg(par, 0xC5, 0x80);
+	write_reg(par, 0xC6, 0x73);
+	write_reg(par, 0xC7, 0x00);
+	write_reg(par, 0xC8, 0x33, 0x33);
+	write_reg(par, 0xC9, 0x5B);
+	write_reg(par, 0xCA, 0x5A);
+	write_reg(par, 0xCB, 0x5D);
+	write_reg(par, 0xCC, 0x5C);
+	write_reg(par, 0xCD, 0x33, 0x33);
+	write_reg(par, 0xCE, 0x5F);
+	write_reg(par, 0xCF, 0x5E);
+	write_reg(par, 0xD0, 0x61);
+	write_reg(par, 0xD1, 0x60);
+	write_reg(par, 0xB0, 0x3A, 0x3A, 0x00, 0x00);
+	write_reg(par, 0xB6, 0x32);
+	write_reg(par, 0xB7, 0x80);
+	write_reg(par, 0xB8, 0x73);
+	write_reg(par, 0xE0, 0x00);
+	write_reg(par, 0xE1, 0x03, 0x0F);
+	write_reg(par, 0xE2, 0x04);
+	write_reg(par, 0xE3, 0x01);
+	write_reg(par, 0xE4, 0x0E);
+	write_reg(par, 0xE5, 0x01);
+	write_reg(par, 0xE6, 0x19);
+	write_reg(par, 0xE7, 0x10);
+	write_reg(par, 0xE8, 0x10);
+	write_reg(par, 0xE9, 0x21);
+	write_reg(par, 0xEA, 0x12);
+	write_reg(par, 0xEB, 0xD0);
+	write_reg(par, 0xEC, 0x04);
+	write_reg(par, 0xED, 0x07);
+	write_reg(par, 0xEE, 0x07);
+	write_reg(par, 0xEF, 0x09);
+	write_reg(par, 0xF0, 0xD0);
+	write_reg(par, 0xF1, 0x0E);
+	write_reg(par, 0xF9, 0x56);
+	write_reg(par, 0xF2, 0x26, 0x1B, 0x0B, 0x20);
+	write_reg(par, 0xEC, 0x04);
+	write_reg(par, 0x35, 0x00);
+	write_reg(par, 0x44, 0x00, 0x10);
+	write_reg(par, 0x46, 0x10);
+	write_reg(par, 0xFF, 0x00);	/* leave vendor command set */
+	write_reg(par, 0x3A, 0x05);	/* RGB565 */
+
+	/* ---- display on sequence ---- */
+	write_reg(par, 0x11);	/* sleep out */
+	mdelay(200);
+	write_reg(par, 0x29);	/* display on */
+	mdelay(150);
+	write_reg(par, 0x2A, 0x00, 0x0C, 0x00, 0x99);
+	write_reg(par, 0x2B, 0x00, 0x00, 0x01, 0xAB);
+	mdelay(20);
+
+	return 0;
+}
+
+/*
+ * blank(): on=true -> display off (0x28), on=false -> display on (0x29).
+ * The OEM version has the same writes plus debug-only trace branches.
+ */
+static int blank(struct fbtft_par *par, bool on)
+{
+	write_reg(par, on ? 0x28 : 0x29);
+
+	return 0;
+}
+
+/*
+ * set_var(): MADCTL (0x36) selection, verbatim from OEM set_var().
+ * fbtft_register_framebuffer() calls this right after init_display().
+ *
+ *   rotate   0  -> 0xC0 | (bgr << 3)   (MX|MY)
+ *   rotate  90  -> 0x60 | (bgr << 3)   (MX|MV)
+ *   rotate 180  -> 0x00 | (bgr << 3)   (none)
+ *   rotate 270  -> 0xA0 | (bgr << 3)   (MY|MV)   <-- E87N DTB uses 270
+ */
+static int set_var(struct fbtft_par *par)
+{
+	switch (par->info->var.rotate) {
+	case 0:
+		write_reg(par, 0x36, 0xC0 | (par->bgr << 3));
+		break;
+	case 90:
+		write_reg(par, 0x36, 0x60 | (par->bgr << 3));
+		break;
+	case 180:
+		write_reg(par, 0x36, 0x00 | (par->bgr << 3));
+		break;
+	case 270:
+		write_reg(par, 0x36, 0xA0 | (par->bgr << 3));
+		break;
+	}
+
+	return 0;
+}
+
+/*
+ * set_addr_win(): GRAM window, verbatim from OEM set_addr_win().
+ *
+ * The OEM applies a per-rotation offset.  With rotate=270 the offset is +12
+ * on the y (PASET / 0x2B) axis only and none on x (CASET / 0x2A).  Adding
+ * the offset to both axes pushes the row range past the GRAM end (0..427)
+ * and results in a black screen.
+ */
+static void set_addr_win(struct fbtft_par *par, int xs, int ys, int xe, int ye)
+{
+	switch (par->info->var.rotate) {
+	case 0:
+		xs += 14;
+		xe += 14;
+		break;
+	case 90:
+		ys += 14;
+		ye += 14;
+		break;
+	case 180:
+		xs += 12;
+		xe += 12;
+		break;
+	case 270:
+		ys += 12;
+		ye += 12;
+		break;
+	}
+
+	write_reg(par, 0x2A, (xs >> 8) & 0xFF, xs & 0xFF,
+		  (xe >> 8) & 0xFF, xe & 0xFF);
+	write_reg(par, 0x2B, (ys >> 8) & 0xFF, ys & 0xFF,
+		  (ye >> 8) & 0xFF, ye & 0xFF);
+	write_reg(par, 0x2C);	/* memory write */
+}
+
+/*
+ * set_gamma(): verbatim from OEM set_gamma().
+ * Writes curve 0 to 0x60..0x6E and curve 1 to 0x70..0x7E.
+ */
+static int set_gamma(struct fbtft_par *par, u32 *curves)
+{
+	int i, j;
+
+	write_reg(par, 0xFF, 0xA5);
+	for (i = 0; i < par->gamma.num_curves; i++) {
+		for (j = 0; j < par->gamma.num_values; j++) {
+			write_reg(par, 0x60 + 0x10 * i + j,
+				  curves[par->gamma.num_values * i + j]);
+		}
+	}
+	write_reg(par, 0xFF, 0x00);
+
+	return 0;
+}
+
+static struct fbtft_display display = {
+	.regwidth = 8,
+	.buswidth = 8,
+	.width = 428,
+	.height = 142,
+	.bpp = 16,
+	.gamma = NV3007_GAMMA_DEFAULT,
+	.gamma_num = 2,
+	.gamma_len = 15,
+	.fbtftops = {
+		.init_display = init_display,
+		.set_addr_win = set_addr_win,
+		.set_var = set_var,
+		.set_gamma = set_gamma,
+		.blank = blank,
+	},
+};
+
+FBTFT_REGISTER_DRIVER(DRVNAME, "newvisionu,nv3007", &display);
+
+MODULE_ALIAS("spi:nv3007");
+MODULE_AUTHOR("open-source E87N port");
+MODULE_DESCRIPTION("fbtft driver for NewVision NV3007 SPI LCD (OEM reconstruction)");
+MODULE_LICENSE("GPL v2");

diff --git a/drivers/staging/fbtft/Kconfig b/drivers/staging/fbtft/Kconfig
