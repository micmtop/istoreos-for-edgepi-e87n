#!/bin/sh /etc/rc.common
# E87N LVGL 屏幕显示服务
# 依赖: /usr/bin/e87n-display（内置 UI）、/usr/sbin/e87n-theme（导入的主题）、
#       /etc/config/e87n-display
# page 取值: 1-4 | cycle | theme:<id>
START=97
STOP=12

EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Show service status"

PIDFILE=/var/run/e87n-display.pid

start() {
    local enabled page cycle_seconds custom_text args
    enabled=$(uci -q get e87n-display.global.enabled)
    [ "$enabled" = "0" ] && { echo "e87n-display disabled"; return 0; }

    [ -c /dev/fb0 ] || { echo "e87n-display: /dev/fb0 not present"; return 1; }

    page=$(uci -q get e87n-display.global.page)
    page=${page:-1}
    cycle_seconds=$(uci -q get e87n-display.global.cycle_seconds)
    cycle_seconds=${cycle_seconds:-10}

    # 开机清屏：fbtft 按 dirty 行增量刷新不会覆盖 GRAM 残留，先写全黑帧
    [ -x /usr/sbin/screen-ctl ] && /usr/sbin/screen-ctl off_fb >/dev/null 2>&1

    # ---- 导入的主题：交给 e87n-theme 运行（ELF app 或静态帧）----
    case "$page" in
        theme:*)
            tid="${page#theme:}"
            if [ -x /usr/sbin/e87n-theme ] && [ -d "/etc/e87n-display/themes/$tid" ]; then
                /usr/sbin/e87n-theme run "$tid" >/dev/null 2>&1 &
                echo $! > "$PIDFILE"
                echo "e87n-display start: theme:$tid"
                return 0
            fi
            echo "e87n-display: theme '$tid' not installed, falling back to page 1"
            uci -q set e87n-display.global.page=1
            uci -q commit e87n-display
            page=1
            ;;
    esac

    if [ "$page" = "cycle" ]; then
        args="cycle $cycle_seconds"
    else
        case "$page" in
            1|2|3|4) args="$page" ;;
            *) echo "e87n-display: invalid page '$page', using 1"; args="1" ;;
        esac
    fi

    # 自定义文本行（list）拼接到命令行参数
    for line in $(uci -q get e87n-display.global.custom_text); do
        # uci list 输出用单引号包裹，去掉
        line=${line#\'}; line=${line%\'}
        [ -n "$line" ] && args="$args '$line'"
    done

    echo "e87n-display start: $args"
    /usr/bin/e87n-display $args &
    echo $! > "$PIDFILE"
}

stop() {
    [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    # 兼容 busybox：pidof 可用，killall 也可用
    killall e87n-display 2>/dev/null || true
    # 关机前保留当前背光（由 screen 服务管理）
}

status() {
    if pidof e87n-display >/dev/null 2>&1; then
        echo "e87n-display: running (builtin)"
    elif [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "e87n-display: running (theme)"
    else
        echo "e87n-display: stopped"
    fi
}
