{
    "luci-app-e87n": {
        "title": "E87N 风扇与屏幕控制",
        "description": "Grant access to E87N fan/screen LuCI page",
        "read": {
            "cgi-io": [ "exec" ],
            "file": {
                "/www/cgi-bin/e87n": [ "exec" ],
                "/usr/bin/fanctl": [ "exec" ],
                "/usr/sbin/screen-ctl": [ "exec" ],
                "/usr/bin/e87n-app-custom": [ "exec" ],
                "/sys/class/gpio/gpio524/value": [ "read" ],
                "/sys/class/graphics/fb0/blank": [ "read" ]
            },
            "ubus": {
                "luci": [ "getMenu" ]
            },
            "uci": [ "fan", "screen", "e87n-display" ]
        },
        "write": {
            "file": {
                "/sys/class/gpio/gpio524/value": [ "write" ],
                "/sys/class/graphics/fb0/blank": [ "write" ]
            },
            "uci": [ "fan", "screen", "e87n-display" ]
        }
    }
}
