#!/bin/sh
# /www/cgi-bin/e87n - E87N 风扇/屏幕控制 CGI 后端（ash 实现，不依赖 jshn）
# API:
#   e87n?action=status                      返回综合状态（温度=摄氏度, 含曲线）
#   e87n?action=set_fan&mode=auto|manual|off[&pwm=0-255]
#   e87n?action=set_screen&state=on|off
#   e87n?action=set_display&page=1-4|cycle[&cycle=秒][&text=行] (text 可多次提交)
#   e87n?action=preview                     屏幕帧 base64 + 尺寸

# ---------- 通用 ----------
printf 'Content-Type: application/json\r\n\r\n'

json_esc() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\r//g; s/\t/\\t/g'
}

# 探测 pwm1 与温度路径（hwmon 编号可变）
PWM_PATH=""
for d in /sys/class/hwmon/hwmon*/pwm1; do
    [ -r "$d" ] && { PWM_PATH="$d"; break; }
done
TEMP_FILE=""
for t in /sys/class/thermal/thermal_zone0/temp /sys/class/hwmon/hwmon*/temp1_input; do
    [ -r "$t" ] && { TEMP_FILE="$t"; break; }
done

read_int() { cat "$1" 2>/dev/null | tr -d '\n'; }

# 从 QUERY_STRING 提取参数（兼容开头的无 ? 形式）
qparam() {
    echo "$QUERY_STRING" | sed 's/&/\n/g' | sed -n "s/^$1=\(.*\)$/\1/p" | head -1
}

ACTION=$(qparam action)

# 背光状态：优先 pwm-backlight brightness (>0 亮 / 0 灭)，其次 fb0/blank，最后 GPIO
BACKLIGHT="unknown"
BLDIR=/sys/class/backlight/backlight
if [ -r "$BLDIR/brightness" ]; then
    BL=$(cat "$BLDIR/brightness" 2>/dev/null | tr -d '\n')
    case "$BL" in
        ''|*[!0-9]*) ;;
        0) BACKLIGHT="off" ;;
        *) BACKLIGHT="on" ;;
    esac
elif [ -r /sys/class/graphics/fb0/blank ]; then
    BL=$(cat /sys/class/graphics/fb0/blank 2>/dev/null | tr -d '\n')
    [ "$BL" = "0" ] && BACKLIGHT="on"
    [ "$BL" = "1" ] && BACKLIGHT="off"
else
    GPIO_N=$(uci -q get screen.global.gpio 2>/dev/null); GPIO_N=${GPIO_N:-524}
    if [ -r "/sys/class/gpio/gpio$GPIO_N/value" ]; then
        POL=$(uci -q get screen.global.polarity 2>/dev/null); POL=${POL:-low}
        V=$(cat "/sys/class/gpio/gpio$GPIO_N/value" 2>/dev/null)
        if [ "$POL" = "low" ]; then
            [ "$V" = "0" ] && BACKLIGHT="on" || BACKLIGHT="off"
        else
            [ "$V" = "1" ] && BACKLIGHT="on" || BACKLIGHT="off"
        fi
    fi
fi

case "$ACTION" in
    status)
        TEMP_RAW=""; PWM="--"
        [ -n "$TEMP_FILE" ] && TEMP_RAW=$(read_int "$TEMP_FILE")
        [ -n "$PWM_PATH" ] && PWM=$(read_int "$PWM_PATH")
        # 温度: 毫摄氏度 -> 摄氏度（divisor=1000），保留整数
        DIV=$(uci -q get fan.global.temp_divisor 2>/dev/null); DIV=${DIV:-1000}
        TEMP="--"
        case "$TEMP_RAW" in
            ''|*[!0-9]*) ;;
            *) TEMP=$((TEMP_RAW / DIV)) ;;
        esac

        FAN_MODE=$(uci -q get fan.global.mode 2>/dev/null); FAN_MODE=${FAN_MODE:-auto}
        FAN_ENABLED=$(uci -q get fan.global.enabled 2>/dev/null); FAN_ENABLED=${FAN_ENABLED:-1}
        MANUAL_PWM=$(uci -q get fan.global.manual_pwm 2>/dev/null); MANUAL_PWM=${MANUAL_PWM:-128}
        PIDOF=$(pidof fan-control 2>/dev/null); [ -n "$PIDOF" ] && fan_run=1 || fan_run=0
        PIDOF2=$(pidof e87n-display 2>/dev/null); [ -n "$PIDOF2" ] && disp_run=1 || disp_run=0
        DISP_PAGE=$(uci -q get e87n-display.global.page 2>/dev/null); DISP_PAGE=${DISP_PAGE:-1}
        DISP_CYCLE=$(uci -q get e87n-display.global.cycle_seconds 2>/dev/null); DISP_CYCLE=${DISP_CYCLE:-10}

        # 温控曲线: 从 uci list 逐行输出
        CURVE_JSON=""
        SEP=""
        echo "$(uci -q get fan.global.curve 2>/dev/null)" | tr ' ' '\n' | grep -v '^$' | while read -r pt; do
            pt=$(echo "$pt" | tr -d "'")
            [ -z "$pt" ] && continue
            t=${pt%%:*}; p=${pt##*:}
            printf '%s{"t":%s,"pwm":%s}' "$SEP" "${t%%[!0-9]*}" "${p%%[!0-9]*}"
            SEP=","
        done > /tmp/e87n-curve.json
        CURVE_JSON=$(cat /tmp/e87n-curve.json 2>/dev/null); rm -f /tmp/e87n-curve.json

        FB_W=""; FB_H=""
        if [ -r /sys/class/graphics/fb0/virtual_size ]; then
            VS=$(cat /sys/class/graphics/fb0/virtual_size); FB_W=${VS%,*}; FB_H=${VS#*,}
        fi

        printf '{"ok":1,'
        printf '"temp":%s,"pwm":%s,"manual_pwm":%s,' "$TEMP" "$PWM" "$MANUAL_PWM"
        printf '"curve":[%s],' "$CURVE_JSON"
        printf '"fan":{"mode":"%s","enabled":%s,"running":%s},' "$FAN_MODE" "$FAN_ENABLED" "$fan_run"
        printf '"screen":{"state":"%s"},' "$BACKLIGHT"
        printf '"display":{"running":%s,"page":"%s","cycle":%s},' "$disp_run" "$DISP_PAGE" "$DISP_CYCLE"
        printf '"fb":{"w":%s,"h":%s}' "${FB_W:-null}" "${FB_H:-null}"
        printf '}\n'
        ;;
    set_fan)
        M=$(qparam mode)
        PW=$(qparam pwm)
        case "$M" in
            manual)
                case "$PW" in
                    ''|*[!0-9]*) printf '{"ok":0,"err":"pwm required for manual"}\n'; exit 0 ;;
                esac
                [ "$PW" -gt 255 ] 2>/dev/null && PW=255
                OUT=$(/usr/bin/fanctl pwm "$PW" 2>&1); RC=$?
                ;;
            auto|off)
                OUT=$(/usr/bin/fanctl mode "$M" 2>&1); RC=$?
                ;;
            *)
                printf '{"ok":0,"err":"bad mode"}\n'; exit 0 ;;
        esac
        if [ "$RC" -eq 0 ]; then
            printf '{"ok":1,"out":"%s"}\n' "$(json_esc "$OUT")"
        else
            printf '{"ok":0,"err":"%s"}\n' "$(json_esc "$OUT")"
        fi
        ;;
    set_screen)
        S=$(qparam state)
        case "$S" in
            on)
                OUT=$(/usr/sbin/screen-ctl on 2>&1); RC=$?
                printf '{"ok":%s,"state":"on","out":"%s"}\n' "$([ $RC -eq 0 ] && echo 1 || echo 0)" "$(json_esc "$OUT")"
                ;;
            off)
                OUT=$(/usr/sbin/screen-ctl off 2>&1); RC=$?
                printf '{"ok":%s,"state":"off","out":"%s"}\n' "$([ $RC -eq 0 ] && echo 1 || echo 0)" "$(json_esc "$OUT")"
                ;;
            *)
                printf '{"ok":0,"err":"bad state"}\n' ;;
        esac
        ;;
    set_display)
        P=$(qparam page)
        CY=$(qparam cycle)
        TX=$(qparam text)
        [ -z "$P" ] && { printf '{"ok":0,"err":"page required"}\n'; exit 0; }
        case "$P" in
            1|2|3|4|cycle) ;;
            *) printf '{"ok":0,"err":"bad page"}\n'; exit 0 ;;
        esac
        uci -q delete e87n-display.global.custom_text 2>/dev/null
        if [ -n "$TX" ]; then
            for t in $(echo "$QUERY_STRING" | sed 's/&/ /g'); do
                case "$t" in
                    text=*) uci -q add_list e87n-display.global.custom_text="${t#text=}" ;;
                esac
            done
        fi
        uci -q set e87n-display.global.page="$P"
        [ -n "$CY" ] && uci -q set e87n-display.global.cycle_seconds="$CY"
        uci -q commit e87n-display
        /etc/init.d/e87n-display restart >/dev/null 2>&1
        printf '{"ok":1}\n'
        ;;
    preview)
        SZ=0
        if [ -r /sys/class/graphics/fb0/virtual_size ]; then
            VS=$(cat /sys/class/graphics/fb0/virtual_size); W=${VS%,*}; H=${VS#*,}
            SZ=$((W*H*2))
        fi
        [ "$SZ" -le 0 ] && SZ=121552
        printf '{"ok":1,"w":%s,"h":%s,"size":%s,"b64":"' "${W:-142}" "${H:-428}" "$SZ"
        dd if=/dev/fb0 bs=1024 count=$(((SZ+1023)/1024)) 2>/dev/null | \
            head -c "$SZ" | openssl base64 -A 2>/dev/null
        printf '"}\n'
        ;;
    import_frame)
        # POST body = 原始 RGB565 little-endian 帧（142x428，121552 字节），
        # 由浏览器端 canvas 转换后上传。保存并用 screen-ctl raw 显示。
        TMP=/tmp/e87n-frame.raw
        cat > "$TMP" 2>/dev/null
        SIZE=$(wc -c < "$TMP" 2>/dev/null | tr -d ' ')
        if [ -z "$SIZE" ] || [ "$SIZE" -lt 100 ]; then
            rm -f "$TMP"
            printf '{"ok":0,"err":"frame too small (%s bytes)"}\n' "$SIZE"
            exit 0
        fi
        OUT=$(/usr/sbin/screen-ctl raw "$TMP" 2>&1); RC=$?
        printf '{"ok":%s,"size":%s,"out":"%s"}\n' "$([ $RC -eq 0 ] && echo 1 || echo 0)" "$SIZE" "$(json_esc "$OUT")"
        ;;
    *)
        printf '{"ok":0,"err":"unknown action"}\n'
        ;;
esac