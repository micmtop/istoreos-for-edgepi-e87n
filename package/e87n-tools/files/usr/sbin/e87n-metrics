#!/bin/sh
# e87n-metrics - E87N 指标采集 / 对外接口
#
# 用法:
#   e87n-metrics once     计算一次并打印 JSON
#   e87n-metrics json     打印缓存 JSON（daemon 未运行则退化为 once）
#   e87n-metrics daemon   每秒刷新 /var/run/e87n/metrics.json（给自定义 LVGL 程序读）
#
# 对外字段（数值未知时为 -1，字符串未知时为 ""）:
#   ok ts uptime
#   temp_c temp_ok fan_pwm fan_pct fan_mode
#   cpu_pct ram_pct disk_pct
#   rx_bps tx_bps net_iface          (bps = bytes/second，与屏幕上的「下载/上传」同源)
#   wan_ip wan6 lan_ip lan6
#   backlight display_page
#
# 性能约束（重要）:
#   这个守护进程每秒跑一次。早期版本每秒 fork 约 25 个子进程（cut/awk/df/ip/uci/sort/wc），
#   在 4 核 A53 上稳定吃掉一个核的几个百分点。现在：
#     - 每秒只有 1 次 awk，一次读完 /proc/net/dev、/proc/stat、/proc/meminfo、
#       /proc/uptime、温度、PWM
#     - 地址 / 客户端数 / 磁盘 / uci 配置这些慢变量每 SLOW_TICK 秒才刷新一次
#     - 时间基准用 /proc/uptime，不再 fork date
#   新增字段时请沿用这个分级，不要往每秒路径里塞外部命令。
#
# 自定义 LVGL 程序读取方式（不需要任何库）:
#   read() /var/run/e87n/metrics.json，或 C 侧用 docs/sdk/e87n_metrics.c
#   也可: ubus call e87n status

STATE=/var/run/e87n
JSON=$STATE/metrics.json
ST=$STATE/net.state
SLOW=$STATE/slow.state
BL_STATE=/tmp/e87n-bl.state
SLOW_TICK=5

uci_get() { uci -q get "$1" 2>/dev/null; }

find_first() {   # 返回第一个可读路径
    for f in "$@"; do [ -r "$f" ] && { printf '%s' "$f"; return 0; }; done
    return 1
}

TEMP_FILE=$(find_first /sys/class/thermal/thermal_zone0/temp /sys/class/hwmon/hwmon*/temp1_input)
PWM_FILE=$(find_first /sys/class/hwmon/hwmon*/pwm1)

IFACE=""; INIT=0
init_iface() {
    IFACE=$(uci_get e87n-display.global.iface); [ -n "$IFACE" ] || IFACE=br-lan
    INIT=1
}

# 每秒路径：一次 awk 读完所有快变项 -> "rx tx cpu_total cpu_busy mem_total mem_avail uptime temp_raw pwm"
fast_sample() {
    awk -v iface="$IFACE" -v tf="$TEMP_FILE" -v pf="$PWM_FILE" '
        BEGIN {
            rx = 0; tx = 0
            while ((getline l < "/proc/net/dev") > 0) {
                if (index(l, iface ":") > 0) {
                    sub(/^[^:]*:/, "", l); split(l, a, " ")
                    rx = a[1]; tx = a[9]; break
                }
            }
            ct = 0; cb = 0
            while ((getline l < "/proc/stat") > 0) {
                if (l ~ /^cpu /) {
                    n = split(l, b, " "); t = 0
                    for (i = 2; i <= n; i++) t += b[i]
                    ct = t; cb = t - b[5] - b[6]; break
                }
            }
            mt = 0; ma = 0
            while ((getline l < "/proc/meminfo") > 0) {
                split(l, c, " ")
                if (l ~ /^MemTotal:/) mt = c[2]
                else if (l ~ /^MemAvailable:/) { ma = c[2]; break }
            }
            up = 0
            if ((getline u < "/proc/uptime") > 0) { split(u, x, "."); up = x[1] + 0 }
            temp = -1
            if (tf != "" && (getline r < tf) > 0) { gsub(/[ \t\r\n]/, "", r); if (r ~ /^-?[0-9]+$/) temp = r + 0 }
            pwm = -1
            if (pf != "" && (getline p < pf) > 0) { gsub(/[ \t\r\n]/, "", p); if (p ~ /^[0-9]+$/) pwm = p + 0 }
            # 每一列都必须是数字，否则 shell 端 set -- 会因空字段错位
            printf "%d %d %d %d %d %d %d %d %d\n", rx + 0, tx + 0, ct + 0, cb + 0, mt + 0, ma + 0, up, temp, pwm
        }' 2>/dev/null
}

ip4() { ip -4 addr show "$1" 2>/dev/null | awk '/inet /{sub(/\/.*/,"",$2); print $2; exit}'; }
ip6() { ip -6 addr show "$1" scope global 2>/dev/null | awk '/inet6 /{sub(/\/.*/,"",$2); print $2; exit}'; }

client_count() {
    {
        awk '{print $2}' /tmp/dhcp.leases 2>/dev/null
        ip neigh show dev br-lan 2>/dev/null | awk '/lladdr/{print $5}'
    } | sed '/^$/d' | sort -u | wc -l
}

esc() { printf '%s' "$1" | sed 's/[\\"]/ /g'; }

emit() {
    mkdir -p "$STATE"
    [ "$INIT" = "1" ] || init_iface

    set -- $(fast_sample)
    rx=${1:-0}; tx=${2:-0}; ct=${3:-0}; cb=${4:-0}
    mt=${5:-0}; ma=${6:-0}; uptime=${7:-0}; temp_raw=${8:--1}; fan_pwm=${9:--1}
    case "$rx" in ''|*[!0-9]*) rx=0;; esac
    case "$tx" in ''|*[!0-9]*) tx=0;; esac
    case "$ct" in ''|*[!0-9]*) ct=0;; esac
    case "$cb" in ''|*[!0-9]*) cb=0;; esac
    case "$uptime" in ''|*[!0-9]*) uptime=0;; esac

    # 上次快变量快照
    prx=0; ptx=0; pct=0; pcb=0; pup=$uptime
    [ -r "$ST" ] && read prx ptx pct pcb pup < "$ST" 2>/dev/null
    case "$pup" in ''|*[!0-9]*) pup=$uptime;; esac
    dt=$((uptime - pup)); [ "$dt" -lt 1 ] && dt=1
    [ "$rx" -lt "$prx" ] && prx=$rx
    [ "$tx" -lt "$ptx" ] && ptx=$tx

    rx_bps=$(( (rx - prx) / dt ))
    tx_bps=$(( (tx - ptx) / dt ))
    dct=$((ct - pct)); dcb=$((cb - pcb))
    if [ "$dct" -gt 0 ] && [ "$dcb" -ge 0 ]; then cpu_pct=$(( dcb * 100 / dct )); else cpu_pct=0; fi
    if [ "$mt" -gt 0 ]; then ram_pct=$(( (mt - ma) * 100 / mt )); else ram_pct=0; fi

    printf '%s %s %s %s %s\n' "$rx" "$tx" "$ct" "$cb" "$uptime" > "$ST.tmp" 2>/dev/null && mv "$ST.tmp" "$ST" 2>/dev/null

    # 慢变量：缓存文件第一行是 #uptime，用它判断该不该刷新
    S_TS=$(sed -n 's/^#\([0-9]*\)$/\1/p' "$SLOW" 2>/dev/null)
    case "$S_TS" in ''|*[!0-9]*) S_TS=0;; esac
    if [ $((uptime - S_TS)) -ge "$SLOW_TICK" ] || [ "$S_TS" = "0" ]; then
        _wan4=$(ip4 pppoe-wan); [ -n "$_wan4" ] || _wan4=$(ip4 "$IFACE")
        _wan6=$(ip6 pppoe-wan); [ -n "$_wan6" ] || _wan6=$(ip6 "$IFACE")
        _lan4=$(ip4 br-lan);    [ -n "$_lan4" ] || _lan4=$(uci_get network.lan.ipaddr)
        _lan6=$(ip6 br-lan)
        _bl=$(cat "$BL_STATE" 2>/dev/null); [ -n "$_bl" ] || _bl=unknown
        _page=$(uci_get e87n-display.global.page); [ -n "$_page" ] || _page=1
        _cl=$(client_count 2>/dev/null); [ -n "$_cl" ] || _cl=0
        _dp=$(df -k / 2>/dev/null | awk 'NR==2{gsub(/%/,"",$5); print $5; exit}'); [ -n "$_dp" ] || _dp=0
        _fm=$(uci_get fan.global.mode); [ -n "$_fm" ] || _fm=auto
        _div=$(uci_get fan.global.temp_divisor); [ -n "$_div" ] || _div=1000
        printf '#%s\n%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$uptime" \
            "$_wan4" "$_wan6" "$_lan4" "$_lan6" "$_bl" "$_page" "$_cl" "$_dp" "$_fm" "$_div" \
            > "$SLOW.tmp" 2>/dev/null && mv "$SLOW.tmp" "$SLOW" 2>/dev/null
    fi

    old_ifs=$IFS; IFS='|'
    { read _ts; read _wan4 _wan6 _lan4 _lan6 _bl _page _cl _dp _fm _div; } < "$SLOW" 2>/dev/null
    IFS=$old_ifs
    [ -n "$_div" ] || _div=1000
    [ -n "$_fm" ] || _fm=auto

    temp_c=-1; temp_ok=0
    case "$temp_raw" in
        ''|*[!0-9-]*) ;;
        -1) ;;
        *) temp_c=$(( temp_raw / _div )); temp_ok=1 ;;
    esac
    fan_pct=-1
    case "$fan_pwm" in
        ''|*[!0-9]*) fan_pwm=-1 ;;
        *) fan_pct=$(( fan_pwm * 100 / 255 )) ;;
    esac

    saying=""
    if [ -r "$STATE/saying.json" ]; then
        saying=$(sed -n 's/.*"text"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$STATE/saying.json" | head -1)
    fi
    [ -n "$saying" ] || saying="--"

    {
        printf '{"ok":1,"ts":%s,"uptime":%s,' "$uptime" "$uptime"
        printf '"temp_c":%s,"temp_ok":%s,' "$temp_c" "$temp_ok"
        printf '"cpu_pct":%s,"ram_pct":%s,"disk_pct":%s,' "$cpu_pct" "$ram_pct" "${_dp:-0}"
        printf '"fan_pwm":%s,"fan_pct":%s,"fan_mode":"%s",' "$fan_pwm" "$fan_pct" "$(esc "$_fm")"
        printf '"rx_bps":%s,"tx_bps":%s,"net_iface":"%s",' "$rx_bps" "$tx_bps" "$(esc "$IFACE")"
        printf '"wan_ip":"%s","wan6":"%s","lan_ip":"%s","lan6":"%s",' \
            "$(esc "$_wan4")" "$(esc "$_wan6")" "$(esc "$_lan4")" "$(esc "$_lan6")"
        printf '"backlight":"%s","display_page":"%s",' "$(esc "$_bl")" "$(esc "$_page")"
        printf '"clients":%s,"saying":"%s"}\n' "${_cl:-0}" "$(esc "$saying")"
    }
}

case "$1" in
    once)
        emit
        ;;
    json)
        if [ -r "$JSON" ]; then cat "$JSON"; else emit; fi
        ;;
    daemon)
        mkdir -p "$STATE"
        init_iface
        trap 'exit 0' INT TERM
        while :; do
            emit > "$JSON.tmp" 2>/dev/null && mv "$JSON.tmp" "$JSON" 2>/dev/null
            sleep 1
        done
        ;;
    *)
        echo "Usage: $0 once|json|daemon" >&2
        exit 1
        ;;
esac
