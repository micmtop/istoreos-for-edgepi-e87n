#!/bin/sh /etc/rc.common
# E87N 每日一言守护：有外网时每小时刷新 /var/run/e87n/saying.json
START=98
STOP=9
USE_PROCD=1

start_service() {
    [ -x /usr/sbin/e87n-saying ] || return 0
    mkdir -p /var/run/e87n
    procd_open_instance
    procd_set_param command /usr/sbin/e87n-saying watch
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
