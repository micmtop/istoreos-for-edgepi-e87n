#!/bin/sh
# 固化现场调试出来的 IPv6 / fullcone / UPnP 配置。
#
# 只在"从没应用过"的机器上跑一次（标记放在 /etc/e87n，overlay 会持久），
# 恢复出厂或新刷固件会重新应用；升级后不会覆盖你后来改的设置。
#
# 踩过的坑：
#   filter_aaaa=1              → 所有 AAAA 记录被丢，测出来"没有 IPv6"
#   ra_flags=managed-config    → 客户端等 DHCPv6，不做 SLAAC，拿不到地址
#   wan6 请求 /56              → 电信只给 /60，请求更大会被忽略

MARK=/etc/e87n/.ipv6-upnp-applied
[ -f "$MARK" ] && exit 0
[ -f /etc/config/network ] || exit 0

# ---- IPv6 客户端 ----
uci set network.wan6=interface
uci set network.wan6.device='@wan'
uci set network.wan6.proto='dhcpv6'
uci set network.wan6.reqaddress='try'
uci set network.wan6.reqprefix='60'
uci set network.wan6.norelease='1'
uci set network.wan6.disabled='0'

# ---- LAN：从委派前缀里取一个 /64 ----
uci set network.lan.ip6assign='64'
uci -q delete network.lan.ip6class
uci commit network

# ---- LAN 下发：纯 SLAAC（去掉 managed-config），不分配固定前缀类 ----
uci set dhcp.lan.ra='server'
uci set dhcp.lan.dhcpv6='server'
uci set dhcp.lan.ra_slaac='1'
uci -q delete dhcp.lan.ra_flags
uci -q delete dhcp.lan.ra_management
uci commit dhcp

# ---- dnsmasq 不要过滤 AAAA ----
uci set dhcp.@dnsmasq[0].filter_aaaa='0'
uci commit dhcp

# ---- fullcone（NAT1）+ UPnP ----
uci set firewall.@defaults[0].fullcone='2'
uci commit firewall
uci set upnpd.config.enabled='1'
uci set upnpd.config.enable_upnp='1'
uci set upnpd.config.enable_natpmp='1'
uci set upnpd.config.secure_mode='1'
uci commit upnpd

mkdir -p /etc/e87n
touch "$MARK"
echo "e87n: IPv6 / fullcone / UPnP 默认配置已应用"
exit 0
