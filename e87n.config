# ============================================================
# EdgePi E87N (MT7987A) - iStoreOS-24.10 target configuration
# This is a defconfig fragment; `make defconfig` expands it.
# ============================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_edgepi_e87n=y

# ---- 构建加速 ----
CONFIG_CCACHE=y

# ---- iStoreOS 商店与系统定制 ----
# IMPORTANT (25.12)：商店/向导的 kconfig 里有一条
#   depends on !(PACKAGE_TAR_XZ) || PACKAGE_xz-utils
# 我们开了 CONFIG_PACKAGE_tar 的 xz 支持（TAR_XZ=y）却没装 xz-utils，
# 结果 luci-app-store 被判为不可选、被 defconfig 静默丢掉，
# 连带依赖它的 luci-app-quickstart 也一起消失（固件里没有商店和网络向导）。
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_istoreos-files=y
CONFIG_PACKAGE_luci-app-ota=y
CONFIG_PACKAGE_dkml=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_ntfsprogs=y

# ---- iStoreOS 首页 + 网络向导 (Linkease quickstart) ----
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn=y

# ---- 硬件 NAT (MTK PPE flow offload) ----
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-ipt-offload=y

# ---- E87N 风扇控制 + 屏幕控制 + LVGL 屏幕显示 ----
CONFIG_PACKAGE_e87n-tools=y
# GPT 助手：新机第一次刷完跑 e87n-prep-overlay 把 overlay 挪到独立分区
CONFIG_PACKAGE_e87n-gptfix=y
CONFIG_PACKAGE_e87n-display=y
CONFIG_PACKAGE_luci-app-e87n=y

# ---- LuCI 界面 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y

# ---- 常用工具 ----
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-server=y

# ---- 网络 ----
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-ddns=y

# ---- 远程/安全（内核模块自编译，不依赖商店源）----
CONFIG_PACKAGE_kmod-tun=y

# ---- 存储/NAS（E87N：双 M.2 NVMe + USB 3.2）----
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
# U 盘常见文件系统（FAT32/exFAT/NTFS）。缺 vfat 时 mount 会报
# "unknown filesystem type 'vfat'"，实测过的坑。
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_luci-app-filebrowser=y

# ---- 文件系统工具 ----
# rootfs_data（overlay）首次启动由 fstools 格式化：需要 mkfs.ext4（e2fsprogs）。
# f2fsck/mkf2fs 已在 filogic.mk 的 DEVICE_PACKAGES 里（fstools 可能按检测到的
# mkfs 工具选择 f2fs/ext4），这里补齐 ext4 工具链，避免格式化失败导致无 overlay。
CONFIG_PACKAGE_e2fsprogs=y

# ---- Docker / 容器 ----
# 注意：这些包在固件里必须一次带齐。当前固件没有 opkg 包源
# (/etc/opkg 为空)，运行时无法在线装包，缺一个都起不来。
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
# Docker 缺了就起不来的内核部件：
#   veth        - bridge 网络，缺了容器直接没有网络（当前固件没有！）
#   br_netfilter- 容器端口映射走 iptables 时的桥接过滤
#   dummy       - dockerd 会创建 dummy0 接口
#   ipt-nat     - 容器出网 SNAT / 端口发布 DNAT
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_iptables-nft=y

# ---- zram（配合 Docker 才有意义）----
# 纯路由用不到：内存 78% 空闲时加 zram 只会白吃 CPU。
# 跑容器后内存压力上来，zram(lz4) 能变相多出 30~50% 可用内存。
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
