# ============================================================
# EdgePi E87N (MT7987A) - iStoreOS-24.10 target configuration
# This is a defconfig fragment; `make defconfig` expands it.
# ============================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_edgepi_e87n=y

# ---- 构建加速 ----
CONFIG_CCACHE=y

# ---- iStoreOS 商店与系统定制 ----
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_istoreos-files=y
CONFIG_PACKAGE_luci-app-ota=y
CONFIG_PACKAGE_dkml=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_ntfsprogs=y

# ---- iStoreOS 首页 + 网络向导 (Linkease quickstart) ----
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn=y

# ---- 硬件 NAT (MTK PPE flow offload) ----
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-ipt-offload=y

# ---- E87N 风扇控制 + 屏幕控制 + LVGL 屏幕显示 ----
CONFIG_PACKAGE_e87n-tools=y
CONFIG_PACKAGE_e87n-display=y
CONFIG_PACKAGE_luci-app-e87n=y

# ---- LuCI 界面 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y

# ---- 常用工具 ----
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-server=y

# ---- 网络 ----
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-ddns=y

# ---- 远程/安全（内核模块自编译，不依赖商店源）----
CONFIG_PACKAGE_kmod-tun=y

# ---- 存储/NAS（E87N 有 USB3）----
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_luci-app-filebrowser=y

# ---- 文件系统工具 ----
# rootfs_data（overlay）首次启动由 fstools 格式化：需要 mkfs.ext4（e2fsprogs）。
# f2fsck/mkf2fs 已在 filogic.mk 的 DEVICE_PACKAGES 里（fstools 可能按检测到的
# mkfs 工具选择 f2fs/ext4），这里补齐 ext4 工具链，避免格式化失败导致无 overlay。
CONFIG_PACKAGE_e2fsprogs=y
